# ==============================================================================
# PULSE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection (Neon Serverless Postgres / PostgreSQL)
# - DATABASE_URL: Pooled connection string (-pooler.region.neon.tech), used by app runtime
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/pulse?sslmode=require"

# - DIRECT_URL: Direct unpooled connection string (used for schema migrations & DDL)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/pulse?sslmode=require"

# NextAuth.js v5 Authentication
# Generate a secure 32-byte secret using: openssl rand -base64 32
AUTH_SECRET="your_32_byte_secure_random_auth_secret_here"

# Canonical URL (e.g. http://localhost:3000 for local, or https://your-app.vercel.app on Vercel)
AUTH_URL="http://localhost:3000"

# Set to true for Vercel / reverse proxy deployments to automatically trust x-forwarded-host
AUTH_TRUST_HOST=true

# Application Environment
NEXT_PUBLIC_APP_NAME="Pulse"
NODE_ENV="production"

